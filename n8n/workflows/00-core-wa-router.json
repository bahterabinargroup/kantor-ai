        "options": {}
      }
    },
    {
      "id": "625b45e3-6275-43b2-ac3a-8ac5add52f94",
      "name": "Kirim balasan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
