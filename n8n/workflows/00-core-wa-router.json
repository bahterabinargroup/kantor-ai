{
  "id": "kai_00_core_wa_router",
  "name": "00 · Core WA Router",
  "nodes": [
    {
      "id": "c26cc4c7-d1e4-401d-bd70-200132d33e51",
      "name": "Catatan 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -260
      ],
      "parameters": {
        "content": "**Pintu masuk semua pesan WhatsApp**\nWebhook ← Evolution API → Normalize (cek secret, filter chat) → `dispatch_message` (anti-duplikat + routing + buat tugas, semua di SQL) → panggil webhook agen `agent-<id>`.\nTidak ada agen cocok: chat pribadi dapat daftar agen, grup diam.\nSlot LLM-router (Gemini) bisa dipasang di antara Normalize dan Dispatch nanti.",
        "width": 640,
        "height": 170,
        "color": 4
      }
    },
    {
      "id": "cebba189-4c17-4722-b14b-aeb0329dccfb",
      "name": "Webhook WA",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "a9d39554-f3f6-41be-8e48-4ab9c5a0593b",
      "parameters": {
        "httpMethod": "POST",
        "path": "wa-incoming",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "3b078409-c4a3-4fa1-a24d-a5bbd6bff30e",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Menyaring & menormalkan webhook Evolution API (messages.upsert)\nconst item = $input.first().json;\n\n// 1) keamanan: secret di URL webhook\nconst secret = $env.WEBHOOK_SECRET || '';\nif (secret && item.query?.secret !== secret) return [];\n\n// 2) hanya pesan masuk\nconst body = item.body || {};\nconst event = String(body.event || '').toLowerCase().replace(/_/g, '.');\nif (event !== 'messages.upsert') return [];\nconst d = body.data || {};\nconst key = d.key || {};\nif (key.fromMe || !key.id) return [];\n\nconst chatId = key.remoteJid || '';\nif (!chatId || chatId === 'status@broadcast') return [];\n\n// 3) batasi chat/grup yang diizinkan (kosong = semua)\nconst allowed = ($env.WA_ALLOWED_CHATS || '').split(',').map(s => s.trim()).filter(Boolean);\nif (allowed.length && !allowed.includes(chatId)) return [];\n\nconst m = d.message || {};\nconst text = m.conversation || m.extendedTextMessage?.text || m.imageMessage?.caption\n          || m.videoMessage?.caption || m.documentMessage?.caption || '';\nconst media = m.imageMessage || m.videoMessage || m.documentMessage || m.audioMessage || null;\n\nreturn [{ json: {\n  message_id: key.id,\n  chat_id: chatId,\n  is_group: chatId.endsWith('@g.us'),\n  sender: key.participant || d.participant || chatId,\n  push_name: d.pushName || '',\n  text,\n  message_type: d.messageType || Object.keys(m)[0] || 'unknown',\n  mimetype: media?.mimetype || null,\n  has_mention: ((m.extendedTextMessage?.contextInfo || m.imageMessage?.contextInfo || {}).mentionedJid || []).length > 0,\n  is_reply: !!((m.extendedTextMessage?.contextInfo || m.imageMessage?.contextInfo || {}).quotedMessage),\n  media_base64: m.base64 || d.base64 || null,   // besar — tidak disimpan ke database\n  instance: body.instance || $env.EVOLUTION_INSTANCE || '',\n  timestamp: d.messageTimestamp || null,\n} }];\n"
      }
    },
    {
      "id": "902f0df3-ba55-42c9-9864-8b2528ac82ac",
      "name": "Dispatch (RPC)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/dispatch_message",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_message_id: $json.message_id, p_chat_id: $json.chat_id, p_is_group: $json.is_group, p_text: $json.text, p_meta: { sender: $json.sender, push_name: $json.push_name, message_type: $json.message_type, mimetype: $json.mimetype } }) }}",
        "options": {},
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($env.SUPABASE_SERVICE_KEY.startsWith('eyJ') ? { apikey: $env.SUPABASE_SERVICE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_KEY } : { apikey: $env.SUPABASE_SERVICE_KEY }) }}"
      }
    },
    {
      "id": "2558c099-d679-4a05-bc4a-0839efdef3cc",
      "name": "Ada tugas?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "02d7c257-1e08-4a4e-aeb2-53e8a6471c3a",
              "leftValue": "={{ $json.task_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "526e0233-87f8-4bcb-ace2-05034d9255c0",
      "name": "Build payload agen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Gabungkan pesan asli + hasil dispatch menjadi payload untuk agen\nconst n = $('Normalize').first().json;\nconst d = $input.first().json;\nreturn [{ json: { ...n, raw_text: n.text, text: d.text, task_id: d.task_id, agent_id: d.agent_id } }];\n"
      }
    },
    {
      "id": "42031fd9-9642-4d80-81ce-ca733c7e69f5",
      "name": "Panggil agen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://n8n:5678/webhook/agent-' + $json.agent_id }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "ba520293-6dfc-45cb-b69d-fcf28d0f7121",
      "name": "Tandai tugas gagal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        40
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/finish_task",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_task_id: $('Build payload agen').first().json.task_id, p_status: 'failed', p_error: 'workflow agen tidak merespons (belum aktif?)' }) }}",
        "options": {},
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($env.SUPABASE_SERVICE_KEY.startsWith('eyJ') ? { apikey: $env.SUPABASE_SERVICE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_KEY } : { apikey: $env.SUPABASE_SERVICE_KEY }) }}"
      }
    },
    {
      "id": "6588d395-1514-4270-995e-96e2d1ded0b5",
      "name": "Beri tahu gagal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
