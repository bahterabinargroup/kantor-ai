{
  "id": "kai_sys_wa_watchdog",
  "name": "sys:wa-watchdog",
  "nodes": [
    {
      "id": "0ecc4aa4-e12c-5a4a-8597-1b38630c6b7c",
      "name": "Catatan 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -180
      ],
      "parameters": {
        "content": "Tiap 5 menit: cek webhook Evolution. Kalau URL-nya kosong (bug setelah restart), pasang ulang.",
        "width": 460,
        "height": 90,
        "color": 4
      }
    },
    {
      "id": "a89353d1-e85c-5cf6-aaf1-6c9f8e6ebf56",
      "name": "Tiap 5 menit",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "d8cf10e1-435c-550f-89ac-ba630e63c731",
      "name": "Cek webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://evolution-api:8080/webhook/find/' + $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "800376f0-f817-55b7-b590-63d0d447f287",
      "name": "Webhook terpasang?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "fa1cc3ed-eb21-5e7b-8f4d-c3bac42199d2",
              "leftValue": "={{ $json.url }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "e9b85acb-db26-5138-92e0-3a20d37dac2f",
      "name": "Pasang ulang webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://evolution-api:8080/webhook/set/' + $env.EVOLUTION_INSTANCE }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ enabled: true, url: 'http://n8n:5678/webhook/wa-incoming?secret=' + $env.WEBHOOK_SECRET, webhookByEvents: false, webhookBase64: true, events: ['MESSAGES_UPSERT'] }) }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 8000
    }
  ],
  "connections": {
    "Tiap 5 menit": {
      "main": [
        [
          {
            "node": "Cek webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cek webhook": {
      "main": [
        [
          {
            "node": "Webhook terpasang?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook terpasang?": {
      "main": [
        [],
        [
          {
            "node": "Pasang ulang webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "kai_sys_error_handler"
  },
  "pinData": {}
}
