{
  "id": "kai_sys_wa_watchdog",
  "name": "sys:wa-watchdog",
  "nodes": [
    {
      "id": "a606e0a0-c2b7-42be-906e-1d9fd5c2f995",
      "name": "Catatan 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -180
      ],
      "parameters": {
        "content": "Tiap 5 menit: cek webhook Evolution. Kalau URL-nya kosong (bug setelah restart), pasang ulang.",
        "width": 460,
        "height": 90,
        "color": 4
      }
    },
    {
      "id": "3c910734-46ce-48e8-aa5b-adb997bc06ab",
      "name": "Tiap 5 menit",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "d7ce389d-30eb-436b-bcf6-f71c58c7f617",
      "name": "Cek webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://evolution-api:8080/webhook/find/' + $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "55b13075-1772-4e27-b3df-51825c38ee47",
      "name": "Webhook terpasang?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "3d786065-d8ca-4be6-81f2-d89553a3c96b",
              "leftValue": "={{ $json.url }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "54fb977f-d4bb-4b0a-804d-c61fa36e119c",
      "name": "Pasang ulang webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://evolution-api:8080/webhook/set/' + $env.EVOLUTION_INSTANCE }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ enabled: true, url: 'http://n8n:5678/webhook/wa-incoming?secret=' + $env.WEBHOOK_SECRET, webhookByEvents: false, webhookBase64: true, events: ['MESSAGES_UPSERT'] }) }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Tiap 5 menit": {
      "main": [
        [
          {
            "node": "Cek webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cek webhook": {
      "main": [
        [
          {
            "node": "Webhook terpasang?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook terpasang?": {
      "main": [
        [],
        [
          {
            "node": "Pasang ulang webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "kai_sys_error_handler"
  },
  "pinData": {}
}
