{
  "id": "kai_sys_wa_watchdog",
  "name": "sys:wa-watchdog",
  "nodes": [
    {
      "id": "9260e8b6-8acc-4fb5-aa35-69f5acc55495",
      "name": "Catatan 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -180
      ],
      "parameters": {
        "content": "Tiap 5 menit: cek webhook Evolution. Kalau URL-nya kosong (bug setelah restart), pasang ulang.",
        "width": 460,
        "height": 90,
        "color": 4
      }
    },
    {
      "id": "100a496e-2011-4538-b22e-4454d6d271cc",
      "name": "Tiap 5 menit",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "7b9d6f19-3e28-43c5-935c-d15155df9d83",
      "name": "Cek webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://evolution-api:8080/webhook/find/' + $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "46c7dbda-6fde-400d-88cd-6471dea1d93e",
      "name": "Webhook terpasang?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cef9e0cf-746d-46fe-bd17-52b5d600a9ad",
              "leftValue": "={{ $json.url }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "e7222bcc-7547-4c77-96aa-c2ffeecc1b52",
      "name": "Pasang ulang webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://evolution-api:8080/webhook/set/' + $env.EVOLUTION_INSTANCE }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ enabled: true, url: 'http://n8n:5678/webhook/wa-incoming?secret=' + $env.WEBHOOK_SECRET, webhookByEvents: false, webhookBase64: true, events: ['MESSAGES_UPSERT'] }) }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Tiap 5 menit": {
      "main": [
        [
          {
            "node": "Cek webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cek webhook": {
      "main": [
        [
          {
            "node": "Webhook terpasang?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook terpasang?": {
      "main": [
        [],
        [
          {
            "node": "Pasang ulang webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "kai_sys_error_handler"
  },
  "pinData": {}
}
