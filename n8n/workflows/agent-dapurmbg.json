          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "1WEVt0170RsXi3aB-OCrH-DnGExw-LH6T"
        },
        "options": {}
      },
      "credentials": {
        "googleApi": {
          "id": "aobybr8432rdzXGw",
          "name": "Google Drive - Kantor AI"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "26f01a16-e070-5002-b2b2-9f9442a69c8b",
      "name": "Susun balasan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "jsCode": "// Susun balasan singkat dari hasil dm_record dan hasil unggah ke Drive. Diam kalau tidak ada balasan.\nconst s = $('Siapkan').first().json;\nconst r = $('Catat (RPC dm_record)').first().json;\nconst res = Array.isArray(r) ? (r[0] || {}) : ((r && 'reply' in r) ? r : (r?.dm_record || r || {}));\nlet reply = res.reply || null;\nif (s.too_big) {\n  reply = '⚠️ File terlalu besar untuk disimpan (maks sekitar 8 MB). Coba kirim ulang yang lebih kecil.';\n} else if (s.upload) {\n  let d = null;\n  try { d = $('Unggah ke Drive').first().json; } catch (e) {}\n  if (d && d.id && !d.error) reply = '✅ File tersimpan di Drive (folder RC 0): ' + s.file_name + ' | ' + (res.reply || '');\n  else reply = '⚠️ File diterima tapi gagal disimpan ke Drive. Saya catat dulu, mohon kabari Claude. ' + (res.reply || '');\n}\nreturn [{ json: { chat_id: s.chat_id, task_id: s.task_id, reply, kind: res.kind || 'text' } }];\n"
      }
    },
