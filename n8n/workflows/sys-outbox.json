{
  "id": "kai_sys_outbox",
  "name": "sys:outbox",
  "nodes": [
    {
      "id": "a817db25-6ea2-51d6-b846-ecb11861f8c8",
      "name": "Catatan 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -180
      ],
      "parameters": {
        "content": "Tiap menit: kirim pesan yang antre di tabel wa_outbox ke WhatsApp lewat bot. Untuk mengirim pesan dari mana pun: INSERT (chat_id, text) ke wa_outbox.",
        "width": 480,
        "height": 100,
        "color": 4
      }
    },
    {
      "id": "f104a7c0-6f7c-5002-95a6-af7317f50eac",
      "name": "Tiap menit",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "cc2fb1bd-3620-57d0-98db-c2e539c34f7d",
      "name": "Ambil pesan antre (RPC)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/outbox_claim",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_limit: 5 }) }}",
        "options": {},
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($env.SUPABASE_SERVICE_KEY.startsWith('eyJ') ? { apikey: $env.SUPABASE_SERVICE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_KEY } : { apikey: $env.SUPABASE_SERVICE_KEY }) }}"
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 8000
    },
    {
      "id": "d9c79414-7249-50f2-9a15-a07ad55bb803",
      "name": "Ada pesan?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "10620711-6720-55a5-abdc-c47453113215",
              "leftValue": "={{ $json.chat_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ade6bc36-0322-58cf-b93a-4a16759ae1d3",
      "name": "Kirim pesan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        -60
      ],
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/lib-send-wa",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.chat_id, text: $json.text }) }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 8000
    }
  ],
  "connections": {
    "Tiap menit": {
      "main": [
        [
          {
            "node": "Ambil pesan antre (RPC)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ambil pesan antre (RPC)": {
      "main": [
        [
          {
            "node": "Ada pesan?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ada pesan?": {
      "main": [
        [
          {
            "node": "Kirim pesan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "kai_sys_error_handler"
  },
  "pinData": {}
}
