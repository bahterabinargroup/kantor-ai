{
  "id": "kai_agent_echo",
  "name": "agent:echo",
  "nodes": [
    {
      "id": "eb10c0b6-13d7-4a2d-a855-27bc28f94797",
      "name": "Catatan 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -300
      ],
      "parameters": {
        "content": "**TEMPLATE AGEN** — duplikat workflow ini untuk membuat agen baru.\n1. Ganti path webhook jadi `agent-<id>`, nama workflow jadi `agent:<id>`\n2. Ganti `echo` pada node status\n3. Isi pekerjaan di node 'Kerjakan tugas'\n4. Daftarkan agen di tabel `agents` (lihat docs/TAMBAH-AGEN.md)\nPola tetap: working → kerja → balas → finish_task → idle.",
        "width": 560,
        "height": 190,
        "color": 4
      }
    },
    {
      "id": "7fc6a8dc-f10a-4d2a-8dbc-b8afbaafde56",
      "name": "Webhook agen",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "b51c869d-1703-4ca6-995a-db3da367cace",
      "parameters": {
        "httpMethod": "POST",
        "path": "agent-echo",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "4add465d-308d-4504-9b04-bb8578cde035",
      "name": "Status: kerja",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/lib-set-status",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ agent_id: 'echo', status: 'working', detail: 'Membalas: ' + String($json.body.text || '').slice(0, 60), task_id: $json.body.task_id }) }}",
        "options": {}
      }
    },
    {
      "id": "6132ccf4-a657-4488-ab1f-3f61dc77aae7",
      "name": "Jeda demo 2 dtk",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "amount": 2,
        "unit": "seconds"
      },
      "webhookId": "5e05ffdc-e087-4fae-9774-7dd1b084b09d"
    },
    {
      "id": "7d63b152-5d6a-4dde-a1ba-703fcc70a19f",
      "name": "Kerjakan tugas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// ← GANTI blok ini dengan pekerjaan agen yang sebenarnya.\n// Input: $json.text, $json.chat_id, $json.media_base64, $json.message_type, $json.task_id, ...\nconst p = $('Webhook agen').first().json.body;\nreturn [{ json: { chat_id: p.chat_id, task_id: p.task_id, reply: '🦜 Echo: ' + (p.text || '(kosong)') } }];\n"
      }
    },
    {
      "id": "52c93575-6661-4b5f-8307-d1b06d7a2522",
      "name": "Balas ke WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/lib-send-wa",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.chat_id, text: $json.reply }) }}",
        "options": {}
      }
    },
    {
      "id": "bcd86b25-6672-4903-9014-25539f49d1f9",
      "name": "Tutup tugas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/finish_task",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_task_id: $('Kerjakan tugas').first().json.task_id, p_status: 'done', p_result: { reply: $('Kerjakan tugas').first().json.reply } }) }}",
        "options": {},
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($env.SUPABASE_SERVICE_KEY.startsWith('eyJ') ? { apikey: $env.SUPABASE_SERVICE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_KEY } : { apikey: $env.SUPABASE_SERVICE_KEY }) }}"
      }
    },
    {
      "id": "47d6a118-4db2-4823-899f-300ac99c2154",
      "name": "Status: santai",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/lib-set-status",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ agent_id: 'echo', status: 'idle', detail: 'Selesai' }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Webhook agen": {
