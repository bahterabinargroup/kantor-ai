{
  "id": "kai_agent_echo",
  "name": "agent:echo",
  "nodes": [
    {
      "id": "724fd27e-2451-540e-b733-2593cab552e1",
      "name": "Catatan 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -300
      ],
      "parameters": {
        "content": "**TEMPLATE AGEN** — duplikat workflow ini untuk membuat agen baru.\n1. Ganti path webhook jadi `agent-<id>`, nama workflow jadi `agent:<id>`\n2. Ganti `echo` pada node status\n3. Isi pekerjaan di node 'Kerjakan tugas'\n4. Daftarkan agen di tabel `agents` (lihat docs/TAMBAH-AGEN.md)\nPola tetap: working → kerja → balas → finish_task → idle.",
        "width": 560,
        "height": 190,
        "color": 4
      }
    },
    {
      "id": "f95dbf75-eea8-5c62-b6f5-9661df6afbf1",
      "name": "Webhook agen",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "62d8891e-1da2-5e90-b147-2c110d9060fe",
      "parameters": {
        "httpMethod": "POST",
        "path": "agent-echo",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "60410f35-0b89-5c14-afd3-5be63cedc532",
      "name": "Status: kerja",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/lib-set-status",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ agent_id: 'echo', status: 'working', detail: 'Membalas: ' + String($json.body.text || '').slice(0, 60), task_id: $json.body.task_id }) }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 8000
    },
    {
      "id": "e4498dee-95d4-55b8-b81f-2978100d6056",
      "name": "Jeda demo 2 dtk",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "amount": 2,
        "unit": "seconds"
      },
      "webhookId": "6ff107e4-d529-5aa2-a0eb-14cb3d61f301"
    },
    {
      "id": "a6a0de51-ab39-5a19-8ce3-1aa62a5b8123",
      "name": "Kerjakan tugas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// ← GANTI blok ini dengan pekerjaan agen yang sebenarnya.\n// Input: $json.text, $json.chat_id, $json.media_base64, $json.message_type, $json.task_id, ...\nconst p = $('Webhook agen').first().json.body;\nreturn [{ json: { chat_id: p.chat_id, task_id: p.task_id, reply: '🦜 Echo: ' + (p.text || '(kosong)') } }];\n"
      }
    },
    {
      "id": "00815b0e-78df-5d26-be6e-6610483b1dfc",
      "name": "Balas ke WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/lib-send-wa",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.chat_id, text: $json.reply }) }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 8000
    },
    {
      "id": "301e795d-c340-5636-92e2-63913cc661fe",
      "name": "Tutup tugas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/finish_task",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_task_id: $('Kerjakan tugas').first().json.task_id, p_status: 'done', p_result: { reply: $('Kerjakan tugas').first().json.reply } }) }}",
        "options": {},
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($env.SUPABASE_SERVICE_KEY.startsWith('eyJ') ? { apikey: $env.SUPABASE_SERVICE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_KEY } : { apikey: $env.SUPABASE_SERVICE_KEY }) }}"
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 8000
    },
    {
      "id": "9c25dd3c-fa71-532a-88eb-91cc7ffd67b8",
      "name": "Status: santai",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/lib-set-status",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ agent_id: 'echo', status: 'idle', detail: 'Selesai' }) }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 8000
    }
  ],
