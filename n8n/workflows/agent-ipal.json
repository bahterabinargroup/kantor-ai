{
  "id": "kai_agent_ipal",
  "name": "agent:ipal",
  "nodes": [
    {
      "id": "f9eeccad-ea31-4433-96c2-e165b48b8aca",
      "name": "Catatan 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -300
      ],
      "parameters": {
        "content": "**Agen IPAL** — dipicu pesan grup yang memuat nama dapur/kecamatan atau kata 'ipal'.\nFoto + caption → `ipal_record_report` (cocokkan nama, catat SUDAH hari ini, WIB) → balas singkat.\nTeks dan foto dari pengirim yang sama (≤20 mnt, urutan bebas) digabung. Foto tanpa caption: ditahan diam-diam.",
        "width": 560,
        "height": 150,
        "color": 4
      }
    },
    {
      "id": "71f9d1c3-69a1-4168-a1ca-9895f9294211",
      "name": "Webhook agen",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "c0ccbfd7-e387-468f-be07-8f5f2b966448",
      "parameters": {
        "httpMethod": "POST",
        "path": "agent-ipal",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "3dd899c0-fb71-4743-a84e-fc474fba07a4",
      "name": "Status: kerja",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/lib-set-status",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ agent_id: 'ipal', status: 'working', detail: 'Mencatat laporan dapur', task_id: $json.body.task_id }) }}",
        "options": {}
      }
    },
    {
      "id": "fb38e218-a12e-4fb1-8760-5a13aea728c0",
      "name": "Siapkan data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Obrolan biasa bukan laporan: teks tanpa foto yang me-mention/membalas orang atau lebih dari 40 kata diabaikan.\nconst p = $('Webhook agen').first().json.body;\nconst media = !!(p.mimetype && /^(image|video)\\//.test(p.mimetype)) || /^(image|video)Message$/.test(p.message_type || '');\nconst raw = String(p.raw_text || '').trim();\nconst words = raw.split(/\\s+/).filter(Boolean).length;\nconst reminder = /pengingat|belum\\s+(lapor|report|kirim|setor)|tolong\\s+(lapor|kirim)/i.test(raw);   // pesan pengingat/sosialisasi dari admin bukan laporan\nconst chatter = !media && (p.has_mention || p.is_reply || words > 40 || reminder);\nreturn [{ json: { p_message_id: p.message_id, p_chat_id: p.chat_id, p_text: chatter ? '' : raw,\n                  p_has_media: media, p_sender: p.sender } }];\n"
      }
    },
    {
      "id": "3a4ccd22-9681-421d-ae40-9c03ad19123b",
      "name": "Catat laporan (RPC)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/ipal_record_report",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {},
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($env.SUPABASE_SERVICE_KEY.startsWith('eyJ') ? { apikey: $env.SUPABASE_SERVICE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_KEY } : { apikey: $env.SUPABASE_SERVICE_KEY }) }}"
      }
    },
    {
      "id": "1464f4c8-f77d-4590-97cd-c537cdcd8fa6",
      "name": "Susun balasan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Susun balasan dari hasil ipal_record_report. Diam kalau bukan laporan (obrolan biasa / foto tanpa caption).\nconst p = $('Webhook agen').first().json.body;\nconst r = $input.first().json || {};\nconst rawText = String(p.raw_text || '').trim();\nconst payloadMedia = !!(p.mimetype && /^(image|video)\\//.test(p.mimetype)) || /^(image|video)Message$/.test(p.message_type || '');\nconst hasMedia = (r.has_media !== undefined) ? !!r.has_media : payloadMedia;\nlet reply = '';\nif (r.pending_media) reply = '';   // foto tanpa caption: tunggu teks nama dapur (maks 20 menit), jangan ganggu grup\nelse if (r.matched && r.duplicate) reply = '';\nelse if (r.matched && !hasMedia) reply = '';   // teks saja: tunggu foto 20 menit; sys:ipal-incomplete yang mengumumkan kalau tak datang\nelse if (r.matched) reply = '';   // konfirmasi ✅ dikirim sys:ipal-ack setelah pengirim diam 2 menit (foto/video lanjutan)\nelse if (r.ambiguous && payloadMedia && rawText) reply = '❓ Caption menyebut lebih dari satu dapur. Mohon kirim ulang dengan satu nama dapur saja.';\nelse if (payloadMedia && rawText) reply = '❓ Nama dapur tidak terbaca di caption. Mohon tulis nama dapur, mis. \"IPAL Grabag\".';\nreturn [{ json: { chat_id: p.chat_id, task_id: p.task_id, reply, matched: !!r.matched } }];\n"
      }
    },
    {
      "id": "f13a9bea-7e3b-4afd-a4d0-9f57ae70baec",
      "name": "Ada balasan?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "1b84c26e-6159-4c6a-b611-8d79b6c51091",
              "leftValue": "={{ $json.reply }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "29d40ad9-40c1-453a-a4ec-4344591bdfe7",
      "name": "Balas ke grup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/lib-send-wa",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.chat_id, text: $json.reply }) }}",
        "options": {}
      }
    },
    {
      "id": "24645c92-974e-49b1-ae4d-405da319c8f6",
      "name": "Tutup tugas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/finish_task",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_task_id: $('Susun balasan').first().json.task_id, p_status: 'done', p_result: { matched: $('Susun balasan').first().json.matched } }) }}",
        "options": {},
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($env.SUPABASE_SERVICE_KEY.startsWith('eyJ') ? { apikey: $env.SUPABASE_SERVICE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_KEY } : { apikey: $env.SUPABASE_SERVICE_KEY }) }}"
      }
    },
    {
      "id": "85ef16cf-df05-4302-a3eb-acd735748b98",
      "name": "Status: santai",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/lib-set-status",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ agent_id: 'ipal', status: 'idle', detail: 'Selesai' }) }}",
        "options": {}
      }
    }
  ],
