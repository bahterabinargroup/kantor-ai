{
  "id": "kai_agent_ipal",
  "name": "agent:ipal",
  "nodes": [
    {
      "id": "c8db4c18-c421-4d14-93ae-c18329394a00",
      "name": "Catatan 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -300
      ],
      "parameters": {
        "content": "**Agen IPAL** — dipicu pesan grup yang memuat nama dapur/kecamatan atau kata 'ipal'.\nFoto + caption → `ipal_record_report` (cocokkan nama, catat SUDAH hari ini, WIB) → balas singkat.\nTeks dan foto dari pengirim yang sama (≤20 mnt, urutan bebas) digabung. Foto tanpa caption: ditahan diam-diam.",
        "width": 560,
        "height": 150,
        "color": 4
      }
    },
    {
      "id": "0c5624f9-fe61-4f9f-bb36-4987962fe1fe",
      "name": "Webhook agen",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "3c9bff49-ffe1-44d2-b855-1fd99c77160e",
      "parameters": {
        "httpMethod": "POST",
        "path": "agent-ipal",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "32c4b693-57ee-4795-aefd-a60d1cd6b0e0",
      "name": "Status: kerja",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/lib-set-status",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ agent_id: 'ipal', status: 'working', detail: 'Mencatat laporan dapur', task_id: $json.body.task_id }) }}",
        "options": {}
      }
    },
    {
      "id": "6f22ca3e-1f61-4b1d-a6f2-1c6aa2f65978",
      "name": "Siapkan data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Obrolan biasa bukan laporan: teks tanpa foto yang me-mention/membalas orang atau lebih dari 40 kata diabaikan.\nconst p = $('Webhook agen').first().json.body;\nconst media = !!(p.mimetype && /^(image|video)\\//.test(p.mimetype)) || /^(image|video)Message$/.test(p.message_type || '');\nconst raw = String(p.raw_text || '').trim();\nconst words = raw.split(/\\s+/).filter(Boolean).length;\nconst chatter = !media && (p.has_mention || p.is_reply || words > 40);\nreturn [{ json: { p_message_id: p.message_id, p_chat_id: p.chat_id, p_text: chatter ? '' : raw,\n                  p_has_media: media, p_sender: p.sender } }];\n"
      }
    },
    {
      "id": "a9dee09d-2198-4cd6-9122-efebc4bdb375",
      "name": "Catat laporan (RPC)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/ipal_record_report",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {},
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($env.SUPABASE_SERVICE_KEY.startsWith('eyJ') ? { apikey: $env.SUPABASE_SERVICE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_KEY } : { apikey: $env.SUPABASE_SERVICE_KEY }) }}"
      }
    },
    {
      "id": "99e7ab15-16d9-4e1b-acb1-12ae921de935",
      "name": "Susun balasan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Susun balasan dari hasil ipal_record_report. Diam kalau bukan laporan (obrolan biasa / foto tanpa caption).\nconst p = $('Webhook agen').first().json.body;\nconst r = $input.first().json || {};\nconst rawText = String(p.raw_text || '').trim();\nconst payloadMedia = !!(p.mimetype && /^(image|video)\\//.test(p.mimetype)) || /^(image|video)Message$/.test(p.message_type || '');\nconst hasMedia = (r.has_media !== undefined) ? !!r.has_media : payloadMedia;\nlet reply = '';\nif (r.pending_media) reply = '';   // foto tanpa caption: tunggu teks nama dapur (maks 20 menit), jangan ganggu grup\nelse if (r.matched && r.duplicate) reply = '';\nelse if (r.matched && !hasMedia) reply = '';   // teks saja: tunggu foto 20 menit; sys:ipal-incomplete yang mengumumkan kalau tak datang\nelse if (r.matched) reply = '';   // konfirmasi ✅ dikirim sys:ipal-ack setelah pengirim diam 2 menit (foto/video lanjutan)\nelse if (r.ambiguous && payloadMedia && rawText) reply = '❓ Caption menyebut lebih dari satu dapur. Mohon kirim ulang dengan satu nama dapur saja.';\nelse if (payloadMedia && rawText) reply = '❓ Nama dapur tidak terbaca di caption. Mohon tulis nama dapur, mis. \"IPAL Grabag\".';\nreturn [{ json: { chat_id: p.chat_id, task_id: p.task_id, reply, matched: !!r.matched } }];\n"
      }
    },
    {
      "id": "212ed6f2-7dc3-4130-9508-22a3e8225371",
      "name": "Ada balasan?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c121c936-a6fb-48cf-b8ba-6676af13995c",
              "leftValue": "={{ $json.reply }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "f6fa17ef-6cfb-458d-9540-958552fd89a0",
      "name": "Balas ke grup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/lib-send-wa",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.chat_id, text: $json.reply }) }}",
        "options": {}
      }
    },
    {
      "id": "a3365770-9771-4595-b679-8c97771bbeb6",
      "name": "Tutup tugas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/finish_task",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_task_id: $('Susun balasan').first().json.task_id, p_status: 'done', p_result: { matched: $('Susun balasan').first().json.matched } }) }}",
        "options": {},
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($env.SUPABASE_SERVICE_KEY.startsWith('eyJ') ? { apikey: $env.SUPABASE_SERVICE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_KEY } : { apikey: $env.SUPABASE_SERVICE_KEY }) }}"
      }
    },
    {
      "id": "94bb115b-1e51-426b-8006-6c10968191e0",
      "name": "Status: santai",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/lib-set-status",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ agent_id: 'ipal', status: 'idle', detail: 'Selesai' }) }}",
        "options": {}
      }
    }
  ],
