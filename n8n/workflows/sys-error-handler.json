      "name": "Petakan ke agen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Nama workflow agen harus berbentuk  agent:<id>  agar error bisa dipetakan ke agennya.\nconst e = $input.first().json;\nconst name = e.workflow?.name || '';\nconst m = name.match(/^agent:([a-z0-9_-]+)/i);\nif (!m) return [];   // bukan workflow agen → abaikan (lihat saja di Executions)\nconst msg = `${e.execution?.lastNodeExecuted || 'node?'}: ${e.execution?.error?.message || 'error'}`;\nreturn [{ json: { agent_id: m[1].toLowerCase(), detail: ('Error — ' + msg).slice(0, 280) } }];\n"
      }
    },
    {
      "id": "e650a436-bd47-4ce2-b44b-ac7e2c17412e",
      "name": "Status: macet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/lib-set-status",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ agent_id: $json.agent_id, status: 'blocked', detail: $json.detail }) }}",
        "options": {}
      }
    }
