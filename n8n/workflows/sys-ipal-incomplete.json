{
  "id": "kai_sys_ipal_incomplete",
  "name": "sys:ipal-incomplete",
  "nodes": [
    {
      "id": "1eabddf4-8a30-5ee4-8651-d0da22a20912",
      "name": "Catatan 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -180
      ],
      "parameters": {
        "content": "Tiap 5 menit: teks nama dapur tanpa foto (atau foto tanpa nama dapur) yang tidak berpasangan setelah 20 menit → satu pengumuman 'laporan tidak lengkap' ke grup. Sekali saja per laporan.",
        "width": 480,
        "height": 100,
        "color": 4
      }
    },
    {
      "id": "d92580cc-679d-52c7-957d-b9b8651d648e",
      "name": "Tiap 5 menit",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "258f1dfb-2b7b-5ce1-a4d0-21c2e51bf57a",
      "name": "Cek tidak lengkap (RPC)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/ipal_incomplete_notices",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_minutes: 20 }) }}",
        "options": {},
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($env.SUPABASE_SERVICE_KEY.startsWith('eyJ') ? { apikey: $env.SUPABASE_SERVICE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_KEY } : { apikey: $env.SUPABASE_SERVICE_KEY }) }}"
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 8000
    },
    {
      "id": "ab2d4a31-920f-5102-ba1b-8f1d259d2116",
      "name": "Ada yang tidak lengkap?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "5fdf1880-6acf-5c3c-ba5f-e85c1f7fcc3e",
              "leftValue": "={{ $json.reply }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ee8a5a86-04cc-5a27-8c12-111a2eba4a72",
      "name": "Umumkan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        -60
      ],
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/lib-send-wa",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.IPAL_GROUP_JID, text: $json.reply }) }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 8000
