      "typeVersion": 1,
      "position": [
        0,
        -180
      ],
      "parameters": {
        "content": "Tiap 5 menit: teks nama dapur tanpa foto (atau foto tanpa nama dapur) yang tidak berpasangan setelah 20 menit → satu pengumuman 'laporan tidak lengkap' ke grup. Sekali saja per laporan.",
        "width": 480,
        "height": 100,
        "color": 4
      }
    },
    {
      "id": "64a3a250-01cb-44d0-999c-8b8b569c59a0",
      "name": "Tiap 5 menit",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "d7c2182e-7834-4043-90e7-44f1515f85ca",
      "name": "Cek tidak lengkap (RPC)",
