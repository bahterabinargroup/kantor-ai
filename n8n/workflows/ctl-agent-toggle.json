  "nodes": [
    {
      "id": "656813a4-4cb6-57a5-9e40-4b016f3ca733",
      "name": "Catatan 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -200
      ],
      "parameters": {
        "content": "Dipanggil tombol Nyala/Mati di dashboard (POST /api/agent-toggle → Caddy → webhook ini).\nHanya bisa dicapai lewat dashboard (basic_auth); diblokir dari domain n8n publik.\nBody: {agent_id, enabled}",
        "width": 480,
        "height": 110,
        "color": 4
      }
    },
    {
      "id": "6770f3d9-0f07-5bf5-a57c-3ba0701ccd06",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "e141c1a4-43fd-55de-83b4-e44c49095f9f",
      "parameters": {
        "httpMethod": "POST",
        "path": "ctl-agent-toggle",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "da75f629-121a-5ec8-969a-0afc3afb1ce4",
      "name": "Nyalakan/matikan (RPC)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/set_agent_enabled",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_agent_id: String($json.body.agent_id || ''), p_enabled: $json.body.enabled === true }) }}",
        "options": {},
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($env.SUPABASE_SERVICE_KEY.startsWith('eyJ') ? { apikey: $env.SUPABASE_SERVICE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_KEY } : { apikey: $env.SUPABASE_SERVICE_KEY }) }}"
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 8000
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Nyalakan/matikan (RPC)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "kai_sys_error_handler"
