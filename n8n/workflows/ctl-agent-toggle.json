{
  "id": "kai_ctl_agent_toggle",
  "name": "ctl:agent-toggle",
  "nodes": [
    {
      "id": "e1ab9bb9-77ef-41e2-9fb0-470a2812e441",
      "name": "Catatan 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -200
      ],
      "parameters": {
        "content": "Dipanggil tombol Nyala/Mati di dashboard (POST /api/agent-toggle → Caddy → webhook ini).\nHanya bisa dicapai lewat dashboard (basic_auth); diblokir dari domain n8n publik.\nBody: {agent_id, enabled}",
        "width": 480,
        "height": 110,
        "color": 4
      }
    },
    {
      "id": "14d8194b-1c5b-4178-b230-056db74cb76a",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "be5d4c40-18ac-4b90-936d-a45d5934841b",
      "parameters": {
        "httpMethod": "POST",
        "path": "ctl-agent-toggle",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "86fe8b68-adce-4299-842f-1825dbb37d97",
      "name": "Nyalakan/matikan (RPC)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/set_agent_enabled",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_agent_id: String($json.body.agent_id || ''), p_enabled: $json.body.enabled === true }) }}",
        "options": {},
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($env.SUPABASE_SERVICE_KEY.startsWith('eyJ') ? { apikey: $env.SUPABASE_SERVICE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_KEY } : { apikey: $env.SUPABASE_SERVICE_KEY }) }}"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Nyalakan/matikan (RPC)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
