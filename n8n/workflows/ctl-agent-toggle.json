      ],
      "parameters": {
        "content": "Dipanggil tombol Nyala/Mati di dashboard (POST /api/agent-toggle → Caddy → webhook ini).\nHanya bisa dicapai lewat dashboard (basic_auth); diblokir dari domain n8n publik.\nBody: {agent_id, enabled}",
        "width": 480,
        "height": 110,
        "color": 4
      }
    },
    {
      "id": "b97bbe00-5925-4d6f-a1d5-1cb53671ca83",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "8f8d96ce-6ca3-4480-9b8e-f11c62a90899",
      "parameters": {
        "httpMethod": "POST",
        "path": "ctl-agent-toggle",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "ddc5cedd-abb9-42de-a379-4d05068523f1",
      "name": "Nyalakan/matikan (RPC)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/set_agent_enabled",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_agent_id: String($json.body.agent_id || ''), p_enabled: $json.body.enabled === true }) }}",
        "options": {},
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($env.SUPABASE_SERVICE_KEY.startsWith('eyJ') ? { apikey: $env.SUPABASE_SERVICE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_KEY } : { apikey: $env.SUPABASE_SERVICE_KEY }) }}"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Nyalakan/matikan (RPC)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
