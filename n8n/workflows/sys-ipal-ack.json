{
  "id": "kai_sys_ipal_ack",
  "name": "sys:ipal-ack",
  "nodes": [
    {
      "id": "0745e516-a4f4-426b-ac04-4dd8948b58d3",
      "name": "Catatan 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -180
      ],
      "parameters": {
        "content": "Tiap menit: konfirmasi ✅ laporan IPAL dikirim SETELAH pengirim diam 2 menit (supaya foto/video lanjutan yang masih dikirim tidak terpotong). Satu pesan per dapur.",
        "width": 480,
        "height": 100,
        "color": 4
      }
    },
    {
      "id": "26e94bc4-d4e0-4892-9c72-2759905a1dd6",
      "name": "Tiap menit",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "a161b3ae-206e-4a2d-83b3-5e4b39f80bc0",
      "name": "Cek konfirmasi (RPC)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/ipal_pending_acks",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_quiet_minutes: 2 }) }}",
        "options": {},
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($env.SUPABASE_SERVICE_KEY.startsWith('eyJ') ? { apikey: $env.SUPABASE_SERVICE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_KEY } : { apikey: $env.SUPABASE_SERVICE_KEY }) }}"
      }
    },
    {
      "id": "aa68ba30-25b8-4652-90c1-a393e1ad8c68",
      "name": "Ada konfirmasi?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c4a22590-b016-4702-a8f6-7133e5f2d11b",
              "leftValue": "={{ $json.reply }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "4beff77e-d6dc-4fde-bbc3-af05cd4ec884",
      "name": "Kirim konfirmasi",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        -60
      ],
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/lib-send-wa",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.IPAL_GROUP_JID, text: $json.reply }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Tiap menit": {
      "main": [
        [
          {
