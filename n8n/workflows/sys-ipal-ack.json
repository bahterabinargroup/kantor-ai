{
  "id": "kai_sys_ipal_ack",
  "name": "sys:ipal-ack",
  "nodes": [
    {
      "id": "9705d55c-fffa-51aa-8ceb-a56cf642f513",
      "name": "Catatan 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -180
      ],
      "parameters": {
        "content": "Tiap menit: konfirmasi ✅ laporan IPAL dikirim SETELAH pengirim diam 2 menit (supaya foto/video lanjutan yang masih dikirim tidak terpotong). Satu pesan per dapur.",
        "width": 480,
        "height": 100,
        "color": 4
      }
    },
    {
      "id": "069bb4b4-6a27-5987-bb28-a2d497863910",
      "name": "Tiap menit",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "f2b00cd6-8df9-57af-b436-1b62870295c3",
      "name": "Cek konfirmasi (RPC)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/ipal_pending_acks",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_quiet_minutes: 2 }) }}",
        "options": {},
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($env.SUPABASE_SERVICE_KEY.startsWith('eyJ') ? { apikey: $env.SUPABASE_SERVICE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_KEY } : { apikey: $env.SUPABASE_SERVICE_KEY }) }}"
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 8000
    },
    {
      "id": "1fc49771-a5c6-5994-8c8d-48998fff5ff5",
      "name": "Ada konfirmasi?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "7105cb84-626d-522c-a5d0-c509d0252185",
              "leftValue": "={{ $json.reply }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "0313e29b-9720-5f9c-86db-c18a62e10a76",
      "name": "Kirim konfirmasi",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        -60
      ],
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/lib-send-wa",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.IPAL_GROUP_JID, text: $json.reply }) }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 8000
    }
  ],
  "connections": {
    "Tiap menit": {
      "main": [
        [
          {
            "node": "Cek konfirmasi (RPC)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cek konfirmasi (RPC)": {
      "main": [
        [
          {
            "node": "Ada konfirmasi?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ada konfirmasi?": {
      "main": [
        [
          {
            "node": "Kirim konfirmasi",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "kai_sys_error_handler"
  },
  "pinData": {}
}
