{
  "id": "kai_sys_ipal_ack",
  "name": "sys:ipal-ack",
  "nodes": [
    {
      "id": "b62871cd-a1b5-467c-9eaa-01c9ce0edc3f",
      "name": "Catatan 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -180
      ],
      "parameters": {
        "content": "Tiap menit: konfirmasi ✅ laporan IPAL dikirim SETELAH pengirim diam 2 menit (supaya foto/video lanjutan yang masih dikirim tidak terpotong). Satu pesan per dapur.",
        "width": 480,
        "height": 100,
        "color": 4
      }
    },
    {
      "id": "0a0df6e0-69e6-479e-872a-abe8e9d8bbff",
      "name": "Tiap menit",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "5697af7e-d842-4dee-b916-3a76e68fc248",
      "name": "Cek konfirmasi (RPC)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/ipal_pending_acks",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_quiet_minutes: 2 }) }}",
        "options": {},
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($env.SUPABASE_SERVICE_KEY.startsWith('eyJ') ? { apikey: $env.SUPABASE_SERVICE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_KEY } : { apikey: $env.SUPABASE_SERVICE_KEY }) }}"
      }
    },
    {
      "id": "45168a5c-6f5c-4d3d-96f2-1d0d3d2cf2bf",
      "name": "Ada konfirmasi?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "72d2feb5-dc7d-498b-ac60-24cab3485945",
              "leftValue": "={{ $json.reply }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "701f96b8-8133-4b8a-8fd2-fbe8cea7b9e2",
      "name": "Kirim konfirmasi",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        -60
      ],
      "parameters": {
        "method": "POST",
        "url": "http://n8n:5678/webhook/lib-send-wa",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.IPAL_GROUP_JID, text: $json.reply }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
