{
  "id": "kai_ctl_agent_profile",
  "name": "ctl:agent-profile",
  "nodes": [
    {
      "id": "9c0d16ef-bf28-5cc0-add9-8460dd01c1d1",
      "name": "Catatan 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -200
      ],
      "parameters": {
        "content": "Dipanggil form 'Ubah' di dashboard (POST /api/agent-profile → Caddy → webhook ini).\nBody: {agent_id, name, emoji, color}. Hanya lewat dashboard (basic_auth).",
        "width": 480,
        "height": 100,
        "color": 4
      }
    },
    {
      "id": "b7eb655e-5fcf-506e-a523-05b728ecc577",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "ec1e5bd2-44c0-561c-b439-ceafff9464bf",
      "parameters": {
        "httpMethod": "POST",
        "path": "ctl-agent-profile",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "dda21e44-b6fd-58fa-86cd-f955edda1127",
      "name": "Ubah profil (RPC)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/update_agent_profile",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_agent_id: String($json.body.agent_id || ''), p_name: $json.body.name || null, p_emoji: $json.body.emoji || null, p_color: $json.body.color || null }) }}",
        "options": {},
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($env.SUPABASE_SERVICE_KEY.startsWith('eyJ') ? { apikey: $env.SUPABASE_SERVICE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_KEY } : { apikey: $env.SUPABASE_SERVICE_KEY }) }}"
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 8000
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Ubah profil (RPC)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "kai_sys_error_handler"
  },
  "pinData": {}
