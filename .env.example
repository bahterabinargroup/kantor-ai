# ─── Salin ke .env, atau jalankan ./setup.sh (mengisi secret otomatis) ───
# Nilai dengan karakter $ WAJIB diapit tanda petik tunggal: 'nilai'

TZ=Asia/Jakarta

# ── Domain (arahkan A record ke IP VPS). Untuk uji lokal pakai *.localhost ──
N8N_DOMAIN=n8n.contoh.com
EVOLUTION_DOMAIN=wa.contoh.com
DASHBOARD_DOMAIN=kantor.contoh.com

# ── Secret (diisi otomatis oleh setup.sh) ──
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
EVOLUTION_API_KEY=
BROWSERLESS_TOKEN=
WEBHOOK_SECRET=

# ── Login dashboard (hash bcrypt dibuat oleh setup.sh) ──
DASHBOARD_USER=admin
DASHBOARD_PASS_HASH=

# ── Supabase (project cloud gratis: supabase.com → Project Settings → API) ──
SUPABASE_URL=
# Kunci "publishable" (sb_publishable_...) — aman dibaca dashboard (hanya SELECT, dibatasi RLS)
# (kunci lama "anon" masih berfungsi, tapi Supabase menghentikannya akhir 2026)
SUPABASE_ANON_KEY=
# Kunci "secret" (sb_secret_...) — HANYA untuk n8n, jangan pernah ke browser
# (kunci lama "service_role" masih berfungsi). Dibuat di Project Settings → API Keys.
SUPABASE_SERVICE_KEY=

# ── WhatsApp ──
EVOLUTION_INSTANCE=kantor-ai
# Batasi chat/grup yang boleh memicu agen (JID dipisah koma). Kosong = semua chat.
# Contoh: 120363012345678901@g.us,628123456789@s.whatsapp.net
WA_ALLOWED_CHATS=
# Grup WhatsApp laporan IPAL (tujuan pengingat 14:00 & 17:00 WIB). Cari dengan scripts/cari-grup-wa.sh
IPAL_GROUP_JID=

# ── LLM (dipakai agen nanti; boleh dikosongkan dulu) ──
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Agen Akuntan: model pembaca foto, dan grup "Akuntan Berdikari" (JID, pisah koma) tempat kirim pencairan QRIS & data merchant
# Kosongkan kecuali IP server diblokir Anthropic (403): isi alamat perantara (mis. https://xxx.workers.dev)
ANTHROPIC_BASE_URL=
# Pembaca foto Akuntan: kosong/anthropic atau gemini (pakai GEMINI_API_KEY)
# AKUNTAN_VISION=gemini
# AKUNTAN_GEMINI_MODEL=gemini-2.5-flash
AKUNTAN_MODEL=claude-sonnet-5-5
AKUNTAN_ADMIN_CHATS=

# ── Versi image (pin supaya update tidak merusak) ──
EVOLUTION_VERSION=v2.3.0
N8N_VERSION=latest
